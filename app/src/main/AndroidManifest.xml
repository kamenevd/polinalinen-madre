<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Cycle 7, WeatherPage: грубая геолокация для Open-Meteo (погода за окном).
         Точная (FINE) не нужна — городу хватает и вышек сети. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".MadreApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Madre"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Madre">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Отложено сознательно (2026-07-21): класс ещё не написан. Уведомления
             решили не спешить писать в ночь дедлайна по APK — v3 уже обжигалась
             на баге с батареей из-за поспешной реализации (баг #5). Раскомментировать
             вместе с самим SourdoughNotificationReceiver, когда дойдут руки сделать
             это аккуратно (см. итоговый статус-отчёт от 2026-07-21). -->
        <!--
        <receiver
            android:name=".sourdough.SourdoughNotificationReceiver"
            android:exported="false" />
        -->

    </application>
</manifest>
<!--
    Отличия от v3/master манифеста (сознательно):
    - allowBackup="false" — закрывает баг v3 #3 (ADB backup vulnerability)
    - убран WRITE_EXTERNAL_STORAGE — не нужен на API 26+ с scoped storage + FileProvider
    - добавлен .MadreApplication — понадобится для WorkManager Configuration.Provider
      (см. MadreApplication.kt) вместо статических конструкций в BroadcastReceiver (баг #2)
-->
