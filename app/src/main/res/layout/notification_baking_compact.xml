<?xml version="1.0" encoding="utf-8"?>
<!--
  Cycle 21: свёрнутая строка хода выпечки — тот же клочок бумаги, только в одну
  строку.

  ЗАЧЕМ ОНА. До этого цикла свёрнутую строку рисовала система, и в тёмной теме
  телефона книга оставалась ей на милость: чужой фон, чужие чернила, а из
  цифр — один системный хронометр, который на нуле уходил в минус. Своя
  разметка отвечает за оба: и за читаемость (бумага и чернила свои при любой
  теме), и за цифры (готовая строка, а не бегущий сам по себе счётчик).

  БЮДЖЕТ ВЫСОТЫ. Свёрнутой карточке система отводит около 48dp под содержимое,
  и всё, что не влезло, обрезается молча. Поэтому здесь ровно одна строка —
  шаг и остаток — и тонкая полоска под ней. Номер шага, следующий шаг и ярлык
  живут в развёрнутой карточке; в свёрнутой они стоили бы цифр.

  Строки приходят готовыми из BakingNotificationContent. Здесь ничего не
  считается — проверить это тут было бы нечем.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_compact_paper"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/notification_paper"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="true">

        <!-- «Расстойка · шаг 3 из 8» — обрезается первым, если места мало. -->
        <TextView
            android:id="@+id/notif_compact_step"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:textSize="15sp"
            android:textColor="@color/madre_notif_ink"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="" />

        <!-- «1:02:05» либо «время вышло». Не сжимается и не обрезается: ради
             этих цифр человек и опускает шторку. -->
        <TextView
            android:id="@+id/notif_compact_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="serif"
            android:textSize="17sp"
            android:textColor="@color/madre_notif_ink"
            android:maxLines="1"
            android:text="" />
    </LinearLayout>

    <!-- Ход текущего шага — та же полоска, что в развёрнутой карточке, только
         тоньше. max = 1000. -->
    <ProgressBar
        android:id="@+id/notif_compact_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="8dp"
        android:max="1000"
        android:progressDrawable="@drawable/notif_progress_paper" />
</LinearLayout>
