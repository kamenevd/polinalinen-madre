<?xml version="1.0" encoding="utf-8"?>
<!--
  Cycle 19: развёрнутая карточка хода выпечки — страница книги в шторке.

  ЧТО ЗДЕСЬ НЕ СЧИТАЕТСЯ. Ничего. Все строки приходят готовыми из
  BakingNotificationContent — их там проверяет юнит-тест, а здесь их проверить
  было бы нечем. RemoteViews только раскладывает.

  Cycle 21: ЦИФРЫ ЗДЕСЬ СТОЯТ, А НЕ ИДУТ. Раньше отсчёт рисовал Chronometer —
  он тикал сам, между обновлениями. И уходил в минус: досчитав до своей базы,
  Chronometer не останавливается, а продолжает считать в другую сторону. Пока
  книга жива, следующее обновление через секунду подменяет его словами «время
  вышло»; когда OEM усыпил процесс, а уведомление оставил, — не подменяет
  никто, и в шторке живёт «-4:12». Теперь здесь обычный TextView с готовой
  строкой: замерший процесс оставит на бумаге последнюю известную секунду, и
  это честнее выдуманного минуса.

  ПОЧЕМУ БУМАГА, А НЕ СИСТЕМНЫЙ ФОН. Панель шторки в тёмной теме телефона
  чёрная. Свой фон и свои чернила — единственный способ прочитать книгу на ней
  одинаково при любой теме; values-night для этого не годится, он перекрасил бы
  книгу целиком (hard rule №3). Цвета и подложка дополнительно проставляются из
  кода (BakingProgressService.paperCard): прошивки, перекрашивающие уведомления
  под свою тему, ходят по стандартному шаблону, а не по чужим id.

  КНОПОК ЗДЕСЬ НЕТ. «Пауза» и «Дальше» в шторке означали бы, что ходом выпечки
  можно править вслепую, не глядя на страницу.

  Раскрыть карточку силой Android не даёт, и книга такого не обещает: пока
  человек её не развернул, он читает свёрнутую (notification_baking_compact),
  и та осмысленна сама по себе.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_paper"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/notification_paper"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="16dp">

    <!-- «Соня · Бородинский»: имя закваски и то, что печётся. -->
    <TextView
        android:id="@+id/notif_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:textSize="13sp"
        android:textColor="@color/madre_notif_cocoa"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <!-- «пауза» / «скоро». Скрыт, когда сказать нечего. -->
        <TextView
            android:id="@+id/notif_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:textColor="@color/madre_notif_urgent"
            android:layout_marginEnd="8dp"
            android:visibility="gone"
            android:text="" />

        <!-- «Расстойка · шаг 3 из 8». -->
        <TextView
            android:id="@+id/notif_step"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:textSize="15sp"
            android:textColor="@color/madre_notif_ink"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="" />
    </LinearLayout>

    <!-- Крупный остаток: «1:02:05» либо «время вышло». Готовая строка. -->
    <TextView
        android:id="@+id/notif_timer_static"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="serif"
        android:textSize="30sp"
        android:textColor="@color/madre_notif_ink"
        android:includeFontPadding="false"
        android:text="" />

    <!-- Cycle 20: ход ТЕКУЩЕГО шага по времени. На нуле остатка полоска полна —
         про всю выпечку выше сказано словами, «шаг 3 из 8». max = 1000. -->
    <ProgressBar
        android:id="@+id/notif_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="7dp"
        android:layout_marginTop="10dp"
        android:max="1000"
        android:progressDrawable="@drawable/notif_progress_paper" />

    <!-- «дальше · Формовка». Своего времени у следующего шага нет. -->
    <TextView
        android:id="@+id/notif_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="serif"
        android:textStyle="italic"
        android:textSize="13sp"
        android:textColor="@color/madre_notif_cocoa"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="" />
</LinearLayout>
